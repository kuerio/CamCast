<Window x:Class="CamCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CamCast – Webcam als NDI®-Quelle"
        Height="700" Width="1120" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F4F6"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="410" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Einstellungen ================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="Kamera" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Gerät" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbCamera" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Auflösung" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbResolution" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bildrate" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbFps" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtResolutionHint"
                                   Margin="0,6,0,0"
                                   FontSize="10.5"
                                   Foreground="#FF6B7280"
                                   TextWrapping="Wrap"
                                   Text="" />

                        <TextBlock Text="Capture-Backend" Margin="0,10,0,4" />
                        <ComboBox x:Name="CmbBackend" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Audio" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Audioquelle" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbAudio" />
                        <TextBlock Text="Mikrofon oder Systemaudio (Loopback). Audio wird zusammen mit dem Video als NDI-Quelle gesendet."
                                   TextWrapping="Wrap" FontSize="11" Foreground="#FF6B7280" Margin="0,6,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="NDI®-Ausgabe" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Quellname (erscheint im Netzwerk)" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtSourceName" Margin="0,0,0,10" />

                        <TextBlock Text="NDI-Gruppe (optional)" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtGroup" Margin="0,0,0,10" />

                        <CheckBox x:Name="ChkPreview" Content="Live-Vorschau anzeigen" IsChecked="True" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Start" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoStart" Content="Automatisch mit Windows starten" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkAutoStream" Content="Beim Programmstart sofort streamen" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Beim Schließen in den Infobereich minimieren" />
                    </StackPanel>
                </GroupBox>

                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF6B7280" Margin="2,0,2,0">
                    <Run Text="NDI® ist eine eingetragene Marke von Vizrt NDI AB. Runtime und Tools gibt es unter " />
                    <Hyperlink NavigateUri="https://ndi.video/tools/" RequestNavigate="OnNdiLinkRequestNavigate">ndi.video/tools</Hyperlink>
                    <Run Text="." />
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= Vorschau / Status ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="140" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF101418" CornerRadius="6" ClipToBounds="True">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button x:Name="BtnPreview" Content="Vorschau starten" Width="160" Height="34" Margin="0,0,8,0" Click="OnPreviewClick" />
                <Button x:Name="BtnStart" Content="Stream starten" Width="160" Height="34" Margin="0,0,8,0" Click="OnStartClick" />
                <Button x:Name="BtnStop" Content="Stoppen" Width="110" Height="34" Click="OnStopClick" />
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Status" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Zustand:" Foreground="#FF6B7280" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtState" Text="Gestoppt" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ausgabe:" Foreground="#FF6B7280" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtResolution" Text="–" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bildrate:" Foreground="#FF6B7280" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtFps" Text="–" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Empfänger:" Foreground="#FF6B7280" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtConnections" Text="0" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Backend:" Foreground="#FF6B7280" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtBackend" Text="–" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="Audio &amp; Zähler" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="TxtAudio" Text="Kein Audio" TextWrapping="Wrap" FontSize="11" Foreground="#FF6B7280" />
                        <ProgressBar x:Name="PrgAudioLevel" Height="8" Margin="0,6,0,8" Maximum="1" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Videobilder:" Foreground="#FF6B7280" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtFrames" Text="0" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Audiopuffer:" Foreground="#FF6B7280" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtAudioBuffers" Text="0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Lesefehler:" Foreground="#FF6B7280" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtReadFailures" Text="0" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GroupBox Grid.Row="6" Header="Protokoll" Padding="6">
                <TextBox x:Name="LogBox"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
